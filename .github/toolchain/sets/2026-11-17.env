# Toolchain set 2026-11-17.
#
# A set is immutable once a release was built with it: rollback rebuilds an old
# release with the set named in that release's body (t3mesh-toolchain). Change a
# version by adding a new set file and pointing `current` at it, in a commit to
# main. Workflows never edit this directory.
#
# Values are parsed, not sourced (see .github/scripts/load-toolchain.sh): KEY=value
# only, no quotes or spaces. A value that still starts with TODO fails the build.
TOOLCHAIN_ID=2026-11-17

# Node and pnpm for `pnpm install --frozen-lockfile` and the mobile tests.
# Upstream pins node 26.13.1 and pnpm 12.14.0 at the time of writing.
NODE_VERSION=26.13.1
PNPM_VERSION=12.14.0

# JDK for Gradle and apksigner (actions/setup-java distribution and version).
JAVA_DISTRIBUTION=TODO
JAVA_VERSION=TODO

# Google's commandlinetools-linux-<n>_latest.zip: the number and its SHA-256.
ANDROID_CMDLINE_TOOLS_VERSION=TODO
ANDROID_CMDLINE_TOOLS_SHA256=TODO

# SDK packages: build-tools (also signs and inspects in the release job), the
# platform and the NDK the build compiles with.
ANDROID_BUILD_TOOLS_VERSION=TODO
ANDROID_PLATFORM_VERSION=TODO
ANDROID_NDK_VERSION=TODO

# SHA-256 of files from build-tools;<ANDROID_BUILD_TOOLS_VERSION>, relative to its directory:
# lib/apksigner.jar, zipalign and aapt2. The release job refuses tools that differ.
APKSIGNER_JAR_SHA256=TODO
ZIPALIGN_SHA256=TODO
AAPT2_SHA256=TODO

# Gradle task for the client-certificate module's unit tests, run in the
# prebuilt android/ project, e.g. :t3-client-certificates:testDebugUnitTest.
KOTLIN_TEST_TASK=TODO
